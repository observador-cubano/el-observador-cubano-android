{
  "name": "el-observador-cubano-mobile",
  "version": "1.1.2",
  "private": true,
  "description": "Aplicación Android de El Observador Cubano (Capacitor + WebView)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "sync": "npm run build && cap sync android",
    "apk:debug": "cd android && gradlew.bat assembleDebug",
    "apk:release": "cd android && gradlew.bat assembleRelease",
    "test:android": "cd android && gradlew.bat testDebugUnitTest",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/preferences": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
